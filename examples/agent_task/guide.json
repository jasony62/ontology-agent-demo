    },
    {
      "id": "T2-13",
      "question": "「敏感数据报表开发」会被归类为合规任务吗？",
      "capability": "types_of",
      "params": { "individual": "t_compliance_dev" },
      "answer_hint": "会：可推出 ComplianceTask",
      "via": "defined class"
    },
    {
      "id": "T2-14",
      "question": "哪些智能体可以执行「全栈改造任务」（要求编码与部署双能力）？",
      "capability": "capability_match",
      "params": { "task": "t_full_stack" },
      "answer_hint": "空集：dev_agent 缺部署、deploy_agent 缺编码，多能力必须 AND 全覆盖",
      "via": "R1 多能力 AND（反例）"
    },
    {
      "id": "T2-15",
      "question": "「新功能上线」的执行计划是什么顺序？",
      "capability": "orchestrate",
      "params": { "task": "t_feature" },
      "answer_hint": "t_req → t_login_dev → t_login_review → t_login_test → t_deploy",
