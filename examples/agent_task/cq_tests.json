{
  "suite": "agent_task_cq_regression",
  "version": 1,
  "description": "agent_task 领域 CQ 回归测试集：能力问题 + 工具调用 + 期望答案（LLM-free 确定性判分）。题源：评测 Harness T2 隐含关系档 12 题平移 + #61/#60/#68 修复锚点 8 题，gold 全部由引擎/适配器确定性输出生成（无人工标注）。改本体/公理/规则后跑 cq_regression 一键回归。覆盖：R1 能力匹配（含多能力 AND 否定）/ R2 委派 / R2b 担责 / R3 传递 / R4 合规 / R5-R6 正反例 / 编排顺序 / defined class。",
  "cases": [
    {
      "id": "T2-01",
      "cq": "哪些智能体可以执行「登录模块开发」？",
      "tool": "capability_match",
      "params": {"task": "t_login_dev"},
      "expect": {"type": "set_exact", "pick": "matches.agent", "set": ["dev_agent", "junior_dev"]},
      "rule": "R1"
    },
    {
      "id": "T2-02",
      "cq": "哪些智能体可以执行「登录模块代码审查」？",
      "tool": "capability_match",
      "params": {"task": "t_login_review"},
      "expect": {"type": "set_exact", "pick": "matches.agent", "set": ["dev_agent"]},
      "rule": "R1"
    },
    {
      "id": "T2-03",
      "cq": "哪些智能体可以执行「生产部署发布」？",
      "tool": "capability_match",
      "params": {"task": "t_deploy"},
      "expect": {"type": "set_exact", "pick": "matches.agent", "set": ["deploy_agent"]},
      "rule": "R1"
    },
    {
      "id": "T2-04",
      "cq": "哪些智能体可以执行「新功能上线」？",
      "tool": "capability_match",
      "params": {"task": "t_feature"},
      "expect": {"type": "set_exact", "pick": "matches.agent", "set": []},
      "rule": "R1 反例",
      "note": "无人可整体执行（复合任务能力覆盖不足）——空集是有效期望，防幻觉列举"
    },
    {
      "id": "T2-05",
      "cq": "「登录模块测试执行」依赖哪些任务？请包含间接依赖。",
      "tool": "query_sparql",
      "params": {"sparql": "SELECT ?dep WHERE { <http://ontology.localhost/agent-task#t_login_test> <http://ontology.localhost/agent-task#depends_on>+ ?dep }"},
      "expect": {"type": "set_exact", "pick": "results.dep", "set": ["t_login_review", "t_login_dev", "t_req"]},
      "rule": "R3"
    },
    {
      "id": "T2-06",
      "cq": "「生产部署发布」间接依赖哪些任务？（不含直接依赖）",
      "tool": "query_sparql",
      "params": {"sparql": "SELECT ?dep WHERE { <http://ontology.localhost/agent-task#t_deploy> <http://ontology.localhost/agent-task#depends_on>* ?dep . FILTER(?dep != <http://ontology.localhost/agent-task#t_deploy> && ?dep != <http://ontology.localhost/agent-task#t_login_test>) }"},
      "expect": {"type": "set_exact", "pick": "results.dep", "set": ["t_login_review", "t_login_dev", "t_req"]},
      "rule": "R3"
    },
    {
      "id": "T2-07",
      "cq": "「敏感数据报表开发」有什么约束？",
      "tool": "property_values",
      "params": {"subject": "t_compliance_dev", "property_name": "requires_constraint"},
      "expect": {"type": "set_exact", "pick": "values", "set": ["creq_default"]},
      "rule": "R4",
      "note": "#64 起约束以实例引用（creq_default a ComplianceRequirement）"
    },
    {
      "id": "T2-08",
      "cq": "把「敏感数据报表开发」分配给「初级研发Agent」会怎样？",
      "tool": "assign",
      "params": {"task": "t_compliance_dev", "agent": "junior_dev"},
      "expect": {"type": "exact_struct", "keys": {"assigned": true, "conflict.type": "合规认证冲突", "conflict.rule": "R4"}},
      "rule": "R4"
    },
    {
      "id": "T2-09",
      "cq": "把「敏感数据报表开发」分配给「研发Agent」会怎样？",
      "tool": "assign",
      "params": {"task": "t_compliance_dev", "agent": "dev_agent"},
      "expect": {"type": "exact_struct", "keys": {"assigned": true, "conflict": null}},
      "rule": "R4 边界",
      "note": "已认证不触发冲突（覆盖式重分配）"
    },
    {
      "id": "T2-10",
      "cq": "哪些智能体可以整体执行「双模块开发」？",
      "tool": "capability_match",
      "params": {"task": "t_double_dev"},
      "expect": {"type": "set_exact", "pick": "matches.agent", "set": ["dev_agent", "junior_dev"]},
      "rule": "R2"
    },
    {
      "id": "T2-11",
      "cq": "全系统哪些智能体是「已认证」的（CertifiedAgent）？",
      "tool": "individuals",
      "params": {"class_name": "CertifiedAgent"},
      "expect": {"type": "set_exact", "pick": "individuals", "set": ["dev_agent", "req_agent", "test_agent", "deploy_agent"]},
      "rule": "类别推理"
    },
    {
      "id": "T2-12",
      "cq": "初级研发Agent 属于哪些类别？",
      "tool": "types_of",
      "params": {"individual": "junior_dev"},
      "expect": {"type": "contains", "pick": "types", "contains": ["JuniorDevAgent", "DevAgent", "Agent"]},
      "rule": "子类链",
      "note": "contains 判分：业务类别必须齐；推理机内建类型（Thing/NamedIndividual）随实现浮动，不作硬断言"
    },
    {
      "id": "T2-13",
      "cq": "「敏感数据报表开发」会被归类为合规任务吗？",
      "tool": "types_of",
      "params": {"individual": "t_compliance_dev"},
      "expect": {"type": "contains", "pick": "types", "contains": ["ComplianceTask"]},
      "rule": "defined class",
      "note": "#61 修复锚点：someValuesFrom 要求约束的实例（creq_default），修复前 ComplianceTask 永远推不出"
    },
    {
      "id": "T2-14",
      "cq": "哪些智能体可以执行「全栈改造任务」（要求编码与部署双能力）？",
      "tool": "capability_match",
      "params": {"task": "t_full_stack"},
      "expect": {"type": "set_exact", "pick": "matches.agent", "set": []},
      "rule": "R1 反例·多能力",
      "note": "#59/#68 锚点：dev_agent 缺部署、deploy_agent 缺编码——多能力必须 AND 全覆盖，只满足一项不算可执行。修复前（属性链 OR）dev/junior/deploy 三个都误判可执行"
    },
    {
      "id": "T2-15",
      "cq": "「新功能上线」的执行计划是什么顺序？",
      "tool": "orchestrate",
      "params": {"task": "t_feature"},
      "expect": {"type": "exact_struct", "keys": {
        "steps.task": ["t_req", "t_login_dev", "t_login_review", "t_login_test", "t_deploy"],
        "steps.executor": ["req_agent", "dev_agent", "dev_agent", "test_agent", "deploy_agent"]
      }},
      "rule": "编排顺序",
      "note": "#68 锚点：编排顺序必须精确匹配（depends_on 拓扑序），而非仅「非空」；执行者按可担责优先"
    },
    {
      "id": "T2-16",
      "cq": "「新功能上线」需要人工介入吗？",
      "tool": "property_values",
      "params": {"subject": "t_feature", "property_name": "needs_manual_review"},
      "expect": {"type": "set_exact", "pick": "values", "set": ["true"]},
      "rule": "R5 正例",
      "note": "#68 锚点：五步无人能一人包揽（can_own 为空）且风险 4 → needs_manual_review"
    },
    {
      "id": "T2-17",
      "cq": "「双模块开发」需要人工介入吗？",
      "tool": "property_values",
      "params": {"subject": "t_double_dev", "property_name": "needs_manual_review"},
      "expect": {"type": "set_exact", "pick": "values", "set": []},
      "rule": "R5 反例",
      "note": "#68 锚点：dev_agent 能担责（can_own）→ 不提示人工介入。R5 改判 can_own 后，有人「能做」但没人「能担」才会触发"
    },
    {
      "id": "T2-18",
      "cq": "「敏感数据报表开发」需要双人复核吗？",
      "tool": "property_values",
      "params": {"subject": "t_compliance_dev", "property_name": "needs_second_review"},
      "expect": {"type": "set_exact", "pick": "values", "set": ["true"]},
      "rule": "R6 正例",
      "note": "#68 锚点：SimpleTask 且风险 5 → 强制双人复核"
    },
    {
      "id": "T2-19",
      "cq": "「登录模块开发」需要双人复核吗？",
      "tool": "property_values",
      "params": {"subject": "t_login_dev", "property_name": "needs_second_review"},
      "expect": {"type": "set_exact", "pick": "values", "set": []},
      "rule": "R6 反例",
      "note": "#68 锚点：风险 2，低于阈值，不应产出复核标记（AND 语义零误报）"
    },
    {
      "id": "T2-20",
      "cq": "「敏感数据报表开发」的候选智能体里，谁能担责？",
      "tool": "capability_match",
      "params": {"task": "t_compliance_dev"},
      "expect": {"type": "exact_struct", "keys": {
        "matches.agent": ["dev_agent", "junior_dev"],
        "matches.can_own": [true, false]
      }},
      "rule": "R2b 担责",
      "note": "#60 锚点：候选仍按 can_execute 返回（junior 能力够），「能否接」以 can_own 标注；排序可担责优先"
    }
  ]
}
