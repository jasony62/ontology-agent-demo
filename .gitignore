# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境
.venv/
venv/
env/

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/

# ---------- 运行时 / 配置 ----------
*.log
*.pid
*.local

# 本地服务状态（如有）
.runtime/

# ---------- 部署配置（模板 config/domain.example.json 入库，本地副本不入库） ----------
# 精确路径：不可写成 domain*.json，否则模板会被一起忽略
config/domain.json

# ---------- 运行态领域包（由 ontologyctl domain install 重建，不入库） ----------
# 示例随仓库分发在 examples/；domains/ 下只保留 README 与目录本身
domains/*/

# ---------- macOS ----------
.DS_Store

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp

# ---------- 文档构建 ----------
site/

# ---------- 前端（frontend/app） ----------
frontend/app/node_modules/
frontend/app/dist/

# ---------- 运行时上传的本体 ----------
data/uploads/

# ---------- 本体发布备份（001 批次：extensions/ 增量文件是资产，必须入库；backups/ 忽略） ----------
backups/

# ---------- 本地编辑器 / 工具残留 ----------
# Obsidian 在文档目录打开时生成的本地配置与画布，不随仓库发布
.obsidian/
*.canvas

# ---------- 内部 / 归档文档（不随仓库发布） ----------
# 本体服务改进规划、需求评审、走查报告等内部工作留痕，仅本地留存，不进版本库与 Pages
docs/_archive/

data/workspaces/
