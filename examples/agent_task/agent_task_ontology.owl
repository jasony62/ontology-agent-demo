<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://ontology.localhost/agent-task"
         xmlns="http://ontology.localhost/agent-task#">

<owl:Ontology rdf:about="http://ontology.localhost/agent-task"/>

<owl:ObjectProperty rdf:about="#has_capability">
  <rdfs:domain rdf:resource="#Agent"/>
  <rdfs:range rdf:resource="#Capability"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">智能体具备能力</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agent 拥有的能力（#64 起指向能力实例 cap_*）。R1 全覆盖判定的前提之一。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requires_capability">
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="#Capability"/>
  <owl:inverseOf rdf:resource="#required_by"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">任务所需能力</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">任务完成所需的能力（#64 起指向能力实例）。要求多项时按 AND 全覆盖判定（#59，R1）。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#required_by">
  <rdfs:domain rdf:resource="#Capability"/>
  <rdfs:range rdf:resource="#Task"/>
  <owl:inverseOf rdf:resource="#requires_capability"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">能力被任务需要</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">requires_capability 的显式逆属性（owl:inverseOf）：按「能力 → 任务」方向检索用；由 owlrl 物化产出，G3 冒烟断言其存在。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#depends_on">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="#Task"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">任务依赖</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">任务间前置依赖（宾语先于主语执行）。声明为 TransitiveProperty：闭包由 owlrl 物化，编排（orchestrate）按它排序。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#composed_of">
  <rdfs:domain rdf:resource="#ComplexTask"/>
  <rdfs:range rdf:resource="#Task"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">复合任务的子任务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">复合任务的直接子任务（≥ 2，G4 形状强制）；委派（R2）与担责（R2b）都从子任务合成。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#can_execute">
  <rdfs:domain rdf:resource="#Agent"/>
  <rdfs:range rdf:resource="#Task"/>
  <!-- R1 能力匹配已迁到规则层 rules/R1_capability_coverage.ttl：
       任务要求多能力时「集合全覆盖」超出属性链的单路径蕴含表达力，
       属性链会按 OR 逐条独立推出（只满足一项即判可执行，#59）。
       这里只保留 domain/range 声明；can_execute 由规则层派生，不断言。 -->
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">可执行</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R1/R2 派生（不断言）：Agent 能做该任务的每一步——只承诺「能力够」，不承诺能担责；担责看 can_own（#60）。</rdfs:comment>
</owl:ObjectProperty>

<!-- #60：can_execute 只承诺「能力够」（能做某一步/每一步）；「能对整体负责」
     是更强的判定（能力够 ∧ 约束满足 ∧ 子任务可担责），由规则层
     rules/R2b_can_own.ttl 派生 can_own。R2/R5 一律以 can_own 为担责前提，
     未认证 Agent 不再「能力够」就被当成能整体接管合规任务。 -->
<owl:ObjectProperty rdf:about="#can_own">
  <rdfs:domain rdf:resource="#Agent"/>
  <rdfs:range rdf:resource="#Task"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">能担责</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R2b 派生（不断言，#60）：can_execute 且任务约束全部满足（合规 ⇒ 未过期认证覆盖每项所需能力）且全部子任务可担责。R2 整体委派的担责面与 R5「无人可接手」以此为前提。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#assigned_to">
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="#Agent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">分配给</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">任务当前分配的 Agent（图断言，persist 可恢复）。分配时的合规冲突由 R4 在适配器代码层校验。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requires_constraint">
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="#Constraint"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">任务约束要求</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">任务的资质约束（#64 起指向约束实例 creq_default）。约束满足判定见 can_own（R2b）。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#uses_tool">
  <rdfs:domain rdf:resource="#Agent"/>
  <rdfs:range rdf:resource="#Tool"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">使用工具</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agent 使用的工具设施（#64 起指向工具实例 tool_*）。消费方为图谱展示（graph_export 的工具连线），不参与推理判定。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#holds_certification">
  <rdfs:domain rdf:resource="#Agent"/>
  <rdfs:range rdf:resource="#Certification"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">持有认证</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agent 持有的认证个体（#65）。CertifiedAgent defined class 与 R2a 有效期判定的前提。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#certified_for">
  <rdfs:domain rdf:resource="#Certification"/>
  <rdfs:range rdf:resource="#Capability"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">认证覆盖能力</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">认证覆盖的能力范围——担责判定按范围逐项比对（认证了编码才能担编码的责，#60）。</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#issued_by">
  <rdfs:domain rdf:resource="#Certification"/>
  <rdfs:range rdf:resource="#SecurityTeam"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">认证签发方</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">认证的签发团队（SecurityTeam 实例，示例中 sec_team 统一签发）。</rdfs:comment>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#valid_until">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Certification"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">认证有效期至</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">认证有效期（xsd:date）。R2a 以当前日期比对派生 cert_valid——过期由此可推理（#65 前只能人工改布尔值）。</rdfs:comment>
</owl:DatatypeProperty>

<!-- R7 派生谓词：认证有效期判定（规则层比对当前日期，词汇表先有声明） -->
<owl:DatatypeProperty rdf:about="#cert_valid">
  <rdfs:domain rdf:resource="#Agent"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">认证有效</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R7 派生：Agent 持有的认证中存在 valid_until 未过期的（与当前日期比对）</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_risk_level">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">风险等级</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">任务风险等级 1-5（FunctionalProperty，G4 形状限定取值范围）。R5/R6 以 ≥ 4 为高风险阈值；复合任务风险语义上是子任务最大值，R5 按「自身或任一子孙」判定（#63）。</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#has_description">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">描述</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">人类可读的中文描述（FunctionalProperty），仅展示用，不参与推理。</rdfs:comment>
</owl:DatatypeProperty>

<!-- R5/R6 的派生谓词：规则往图里写结论，词汇表必须先有声明（#62）。
     不声明的话，图谱导出、实体详情、OpenAPI、SHACL 形状全都
     没有任何声明可依赖，消费方只能硬编码字符串去猜。 -->
<owl:DatatypeProperty rdf:about="#needs_manual_review">
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需人工介入</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R5 派生：高风险任务（risk_level ≥ 4）且无任何 Agent 可整体执行时置真，提示人工介入编排与担责</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#needs_second_review">
  <rdfs:domain rdf:resource="#Task"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需双人复核</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R6 派生：高风险单片任务（SimpleTask 且 risk_level ≥ 4）置真，强制第二人复核后放行</rdfs:comment>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Agent">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:disjointWith rdf:resource="#Task"/>
  <owl:disjointWith rdf:resource="#Capability"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">智能体</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">能承担任务的执行主体。与 Task、Capability 互斥（owl:disjointWith）；子类按角色划分（需求/研发/测试/部署），个体是具体的 Agent。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RequirementAgent">
  <rdfs:subClassOf rdf:resource="#Agent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需求分析Agent类</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需求分析 Agent 角色：承担需求分析类工作（如 t_req）。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DevAgent">
  <rdfs:subClassOf rdf:resource="#Agent"/>
  <owl:disjointWith rdf:resource="#TestAgent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">研发Agent类</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">研发 Agent 角色（含其子类初级研发）。与 TestAgent 互斥（owl:disjointWith）——一个 Agent 不同时承担研发与测试两个角色。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#JuniorDevAgent">
  <rdfs:subClassOf rdf:resource="#DevAgent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">初级研发Agent类</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">初级研发 Agent：能力窄于 DevAgent（示例中仅编码），且未持有任何认证——未认证 Agent 的典型样本。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TestAgent">
  <rdfs:subClassOf rdf:resource="#Agent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">测试Agent类</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">测试 Agent 角色：执行测试与质量门禁。与 DevAgent 互斥（owl:disjointWith）。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DeployAgent">
  <rdfs:subClassOf rdf:resource="#Agent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">部署Agent类</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">部署 Agent 角色：生产部署与发布，通常是链条上风险最高的一环。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Task">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:disjointWith rdf:resource="#Agent"/>
  <owl:disjointWith rdf:resource="#Capability"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">任务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">任务：被编排、分配与推理的最小工作单元。与 Agent、Capability 互斥（owl:disjointWith）；子类按结构划分——SimpleTask 单步、ComplexTask 组合。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SimpleTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <owl:disjointWith rdf:resource="#ComplexTask"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">简单任务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">简单任务：单步工作，恰好声明一项能力要求（requires_capability，G4 形状强制）。与 ComplexTask 互斥（owl:disjointWith），不得挂 composed_of（G4 形状）。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ComplexTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">复合任务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">复合任务：由 ≥ 2 个子任务组成（composed_of，G4 形状），本身不直接声明能力；能否整体执行由 R2 委派、能否担责由 R2b 从子任务担责合成。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Capability">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:disjointWith rdf:resource="#Agent"/>
  <owl:disjointWith rdf:resource="#Task"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">能力</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">能力：任务对 Agent 的技能要求。#64 起以个体引用（cap_* 个体），类仅作类型；与 Agent、Task 互斥（owl:disjointWith）。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RequirementAnalysis">
  <rdfs:subClassOf rdf:resource="#Capability"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需求分析</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需求分析能力：产出用户故事与验收标准的技能。实例 cap_requirement_analysis。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Coding">
  <rdfs:subClassOf rdf:resource="#Capability"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">编码实现</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">编码实现能力：编写与修改代码的技能。实例 cap_coding。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CodeReview">
  <rdfs:subClassOf rdf:resource="#Capability"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代码审查</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代码审查能力：评审代码质量的技能。实例 cap_code_review。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Testing">
  <rdfs:subClassOf rdf:resource="#Capability"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">测试执行</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">测试执行能力：运行测试与质量门禁的技能。实例 cap_testing。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Deployment">
  <rdfs:subClassOf rdf:resource="#Capability"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">部署发布</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">部署发布能力：生产环境发布的技能，通常风险最高。实例 cap_deployment。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Tool">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">工具</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">工具：Agent 执行任务时使用的软件设施（IDE / Git / CI/CD / 知识库）。#64 起以个体引用（tool_* 个体），由图谱展示消费 uses_tool 连线。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IDE">
  <rdfs:subClassOf rdf:resource="#Tool"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">集成开发环境</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">集成开发环境工具。实例 tool_ide（dev_agent、junior_dev 使用）。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GitRepo">
  <rdfs:subClassOf rdf:resource="#Tool"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Git 仓库</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Git 代码仓库工具。实例 tool_git_repo（dev_agent、deploy_agent 使用）。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CICD">
  <rdfs:subClassOf rdf:resource="#Tool"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CI/CD 流水线</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CI/CD 流水线工具。实例 tool_cicd（test_agent、deploy_agent 使用）。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KnowledgeBase">
  <rdfs:subClassOf rdf:resource="#Tool"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">知识库</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">知识库工具。实例 tool_knowledge_base（req_agent 使用）。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Constraint">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">约束</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">约束：任务的前置资质要求（任务 requires_constraint 某约束实例）。约束是否被某 Agent 满足由 R2b 担责判定消费。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ComplianceRequirement">
  <rdfs:subClassOf rdf:resource="#Constraint"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">合规认证要求</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">合规认证要求：约束的一种——挂此约束的任务（合规任务）只能派给持有未过期合规认证的 Agent（R4 分配校验、R2b 担责判定）。实例 creq_default。</rdfs:comment>
</owl:Class>


<!-- 认证以独立个体表达（#65）：范围（certified_for）、签发方（issued_by）、
     有效期（valid_until）都可承载——布尔值 has_certified 时代
     「过期这件事不可推理」，只能等过期后人工把 true 改成 false。 -->
<owl:Class rdf:about="#Certification">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资质认证</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">资质认证（#65）：认证以个体表达，带范围（certified_for）、签发方（issued_by）与有效期（valid_until）；Agent 通过 holds_certification 持有。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SecurityTeam">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">安全团队</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">安全团队：认证的签发方（issued_by 的值域），示例中 sec_team 统一签发。</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CertifiedAgent">
  <rdfs:subClassOf rdf:resource="#Agent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已认证智能体</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">已认证智能体（defined class）：持有至少一张认证（∃holds_certification.Certification）的 Agent。「认证未过期」不在此判定——日期不等式 OWL 表达不了，看 R2a 派生的 cert_valid。</rdfs:comment>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Agent"/>
        <owl:Restriction>
          <!-- #65：认证升级为个体后，defined class 表达「持有至少一张认证」；
               「当前有效（未过期）」涉及日期比对，由规则层 R2a 派生 cert_valid 判定，
               OWL 公理表达不了日期不等式 -->
          <owl:onProperty rdf:resource="#holds_certification"/>
          <owl:someValuesFrom rdf:resource="#Certification"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ComplianceTask">
  <rdfs:subClassOf rdf:resource="#Task"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">合规任务</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">合规任务（defined class）：requires_constraint 指向合规约束实例（∃requires_constraint.ComplianceRequirement）的任务，如 t_compliance_dev（#61 起可推导）。</rdfs:comment>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Task"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#requires_constraint"/>
          <owl:someValuesFrom rdf:resource="#ComplianceRequirement"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<!-- ============ 能力/工具/约束的实例（#64） ============
     此前 10 个名字以「类」被当值引用（t_login_dev requires_capability #Coding），
     标签无法承载任何属性（认证等级/有效期/熟练度没地方挂），也让
     ComplianceTask 的 someValuesFrom 永远推不出（值域要求实例，图里只有类）。
     现类保留为类型，引用一律指向个体：类树与实体列表不再出现
     「类同时是实例」的歧义；rdfs:range / 规则的推导路径不变（个体同样满足值域）。 -->

<owl:NamedIndividual rdf:about="#cap_requirement_analysis">
  <rdf:type rdf:resource="#RequirementAnalysis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需求分析能力</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#cap_coding">
  <rdf:type rdf:resource="#Coding"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">编码实现能力</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#cap_code_review">
  <rdf:type rdf:resource="#CodeReview"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">代码审查能力</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#cap_testing">
  <rdf:type rdf:resource="#Testing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">测试执行能力</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#cap_deployment">
  <rdf:type rdf:resource="#Deployment"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">部署发布能力</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#tool_ide">
  <rdf:type rdf:resource="#IDE"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IDE 工具</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#tool_git_repo">
  <rdf:type rdf:resource="#GitRepo"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Git 仓库工具</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#tool_cicd">
  <rdf:type rdf:resource="#CICD"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CI/CD 流水线工具</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#tool_knowledge_base">
  <rdf:type rdf:resource="#KnowledgeBase"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">知识库工具</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#creq_default">
  <rdf:type rdf:resource="#ComplianceRequirement"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">默认合规认证要求</rdfs:label>
</owl:NamedIndividual>

<!-- ============ 认证个体（#65）：范围 + 签发方 + 有效期 ============ -->

<owl:NamedIndividual rdf:about="#sec_team">
  <rdf:type rdf:resource="#SecurityTeam"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">安全合规团队</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#cert_dev_coding">
  <rdf:type rdf:resource="#Certification"/>
  <certified_for rdf:resource="#cap_coding"/>
  <issued_by rdf:resource="#sec_team"/>
  <valid_until rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-06-30</valid_until>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">研发编码合规认证</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#cert_req_analysis">
  <rdf:type rdf:resource="#Certification"/>
  <certified_for rdf:resource="#cap_requirement_analysis"/>
  <issued_by rdf:resource="#sec_team"/>
  <valid_until rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-06-30</valid_until>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需求分析合规认证</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#cert_testing">
  <rdf:type rdf:resource="#Certification"/>
  <certified_for rdf:resource="#cap_testing"/>
  <issued_by rdf:resource="#sec_team"/>
  <valid_until rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-06-30</valid_until>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">测试执行合规认证</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#cert_deployment">
  <rdf:type rdf:resource="#Certification"/>
  <certified_for rdf:resource="#cap_deployment"/>
  <issued_by rdf:resource="#sec_team"/>
  <valid_until rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2027-06-30</valid_until>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">部署发布合规认证</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#req_agent">
  <rdf:type rdf:resource="#RequirementAgent"/>
  <has_capability rdf:resource="#cap_requirement_analysis"/>
  <uses_tool rdf:resource="#tool_knowledge_base"/>
  <holds_certification rdf:resource="#cert_req_analysis"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">负责需求分析、用户故事与验收标准编写</has_description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需求分析Agent</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#dev_agent">
  <rdf:type rdf:resource="#DevAgent"/>
  <has_capability rdf:resource="#cap_coding"/>
  <has_capability rdf:resource="#cap_code_review"/>
  <uses_tool rdf:resource="#tool_ide"/>
  <uses_tool rdf:resource="#tool_git_repo"/>
  <holds_certification rdf:resource="#cert_dev_coding"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">负责编码实现与代码审查，已通过合规认证</has_description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">研发Agent</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#junior_dev">
  <rdf:type rdf:resource="#JuniorDevAgent"/>
  <has_capability rdf:resource="#cap_coding"/>
  <uses_tool rdf:resource="#tool_ide"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">仅具备编码能力，尚未通过合规认证</has_description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">初级研发Agent</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#test_agent">
  <rdf:type rdf:resource="#TestAgent"/>
  <has_capability rdf:resource="#cap_testing"/>
  <uses_tool rdf:resource="#tool_cicd"/>
  <holds_certification rdf:resource="#cert_testing"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">负责测试执行与质量门禁</has_description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">测试Agent</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#deploy_agent">
  <rdf:type rdf:resource="#DeployAgent"/>
  <has_capability rdf:resource="#cap_deployment"/>
  <uses_tool rdf:resource="#tool_cicd"/>
  <uses_tool rdf:resource="#tool_git_repo"/>
  <holds_certification rdf:resource="#cert_deployment"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">负责生产部署与发布</has_description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">部署Agent</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#t_req">
  <rdf:type rdf:resource="#SimpleTask"/>
  <requires_capability rdf:resource="#cap_requirement_analysis"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需求分析：新功能用户故事与验收标准</has_description>
  <has_risk_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</has_risk_level>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">需求分析任务</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#t_login_dev">
  <rdf:type rdf:resource="#SimpleTask"/>
  <requires_capability rdf:resource="#cap_coding"/>
  <depends_on rdf:resource="#t_req"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">登录模块开发</has_description>
  <has_risk_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_risk_level>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">登录模块开发</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#t_login_review">
  <rdf:type rdf:resource="#SimpleTask"/>
  <requires_capability rdf:resource="#cap_code_review"/>
  <depends_on rdf:resource="#t_login_dev"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">登录模块代码审查</has_description>
  <has_risk_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</has_risk_level>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">登录模块代码审查</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#t_login_test">
  <rdf:type rdf:resource="#SimpleTask"/>
  <requires_capability rdf:resource="#cap_testing"/>
  <depends_on rdf:resource="#t_login_review"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">登录模块测试执行</has_description>
  <has_risk_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</has_risk_level>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">登录模块测试执行</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#t_deploy">
  <rdf:type rdf:resource="#SimpleTask"/>
  <requires_capability rdf:resource="#cap_deployment"/>
  <depends_on rdf:resource="#t_login_test"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">生产环境部署发布</has_description>
  <has_risk_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_risk_level>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">生产部署发布</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#t_compliance_dev">
  <rdf:type rdf:resource="#SimpleTask"/>
  <requires_capability rdf:resource="#cap_coding"/>
  <requires_constraint rdf:resource="#creq_default"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">涉及敏感数据的报表开发（需合规认证）</has_description>
  <has_risk_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</has_risk_level>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">敏感数据报表开发</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#t_feature">
  <rdf:type rdf:resource="#ComplexTask"/>
  <composed_of rdf:resource="#t_req"/>
  <composed_of rdf:resource="#t_login_dev"/>
  <composed_of rdf:resource="#t_login_review"/>
  <composed_of rdf:resource="#t_login_test"/>
  <composed_of rdf:resource="#t_deploy"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">新功能上线：需求 → 开发 → 审查 → 测试 → 部署</has_description>
  <has_risk_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_risk_level>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">新功能上线（复合任务）</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#t_double_dev">
  <rdf:type rdf:resource="#ComplexTask"/>
  <composed_of rdf:resource="#t_login_dev"/>
  <composed_of rdf:resource="#t_compliance_dev"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">双模块开发：登录模块 + 合规报表模块</has_description>
  <has_risk_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_risk_level>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">双模块开发（复合任务）</rdfs:label>
</owl:NamedIndividual>

<!-- #68：多能力任务演示锚点——此前 8 个任务每个只挂 1 条 requires_capability，
     can_execute 的 AND 覆盖语义（#59）在数据上不可见。本任务要求「编码 + 部署」
     双能力：dev_agent 缺部署、deploy_agent 缺编码，无人可执行（R1 全覆盖判定），
     也没有人能担责（R2b）——风险 4 时 R5 如实提示人工介入。 -->
<owl:NamedIndividual rdf:about="#t_full_stack">
  <rdf:type rdf:resource="#SimpleTask"/>
  <requires_capability rdf:resource="#cap_coding"/>
  <requires_capability rdf:resource="#cap_deployment"/>
  <has_description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">全栈改造：编码实现 + 生产部署（要求双能力全覆盖）</has_description>
  <has_risk_level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</has_risk_level>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">全栈改造任务</rdfs:label>
</owl:NamedIndividual>


</rdf:RDF>
